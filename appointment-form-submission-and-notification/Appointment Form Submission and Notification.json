      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const data = item.json;\n\n  const fullName = data[\"Full Name\"] || {};\n  const appointment = data[\"Select Appointment Date and Time\"] || {};\n  const phoneField = data[\"Phone Number (for SMS reminders, optional)\"] || {};\n\n  const rawDateTime = appointment.date || \"\";\n  const [rawDate = \"\", rawTime = \"\"] = rawDateTime.split(\" \");\n\n  let appointmentDateDisplay = \"\";\n  let appointmentTimeDisplay = \"\";\n  let appointmentDateRaw = rawDate;\n  let appointmentDateTimeRaw = \"\";\n\n  if (rawDate) {\n    const dateObj = new Date(`${rawDate}T00:00:00`);\n    appointmentDateDisplay = dateObj.toLocaleDateString(\"en-US\", {\n      year: \"numeric\",\n      month: \"long\",\n      day: \"numeric\",\n    });\n  }\n\n  if (rawTime) {\n    const timeObj = new Date(`1970-01-01T${rawTime}:00`);\n    appointmentTimeDisplay = timeObj.toLocaleTimeString(\"en-US\", {\n      hour: \"numeric\",\n      minute: \"2-digit\",\n      hour12: true,\n    });\n  }\n\n  if (rawDate && rawTime) {\n    appointmentDateTimeRaw = `${rawDate}T${rawTime}:00`;\n  }\n\n  const now = new Date();\n  const timestamp =\n    now.getFullYear().toString() +\n    String(now.getMonth() + 1).padStart(2, \"0\") +\n    String(now.getDate()).padStart(2, \"0\") +\n    String(now.getHours()).padStart(2, \"0\") +\n    String(now.getMinutes()).padStart(2, \"0\") +\n    String(now.getSeconds()).padStart(2, \"0\");\n\n  const bookingId = `BK-${timestamp}-${String(index + 1).padStart(3, \"0\")}`;\n\n  return {\n    json: {\n      \"Booking ID\": bookingId,\n      \"Customer Name\": `${fullName.first || \"\"} ${fullName.last || \"\"}`.trim(),\n      \"Email Address\": data[\"Email Address\"] || \"\",\n      \"Phone Number\": phoneField.full || \"\",\n      \"Service\": data[\"Service\"] || \"\",\n      \"Appointment Date\": appointmentDateDisplay,\n      \"Appointment Time\": appointmentTimeDisplay,\n      \"Appointment Date Raw\": appointmentDateRaw,\n      \"Appointment DateTime Raw\": appointmentDateTimeRaw,\n      \"Reminder Status\": \"Pending\",\n      \"Notes\": data[\"Notes\"] || \"\",\n    }\n  };\n});\n"
      },
