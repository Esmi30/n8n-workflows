    {
      "parameters": {
        "jsCode": "return items.flatMap((item) => {\n  const records = item.json.records || [];\n\n  return records.map((record) => {\n    const fields = record.fields || {};\n    const dateText = fields[\"Appointment Date\"] || \"\";\n    const timeText = fields[\"Appointment Time\"] || \"\";\n\n    const combined = `${dateText} ${timeText}`.trim();\n    const appointmentDateTime = DateTime.fromFormat(\n      combined,\n      \"LLLL d, yyyy h:mm a\",\n      { zone: \"Asia/Manila\" }\n    );\n\n    return {\n      json: {\n        id: record.id,\n        createdTime: record.createdTime,\n        fields: fields,\n        appointmentDateTimeISO: appointmentDateTime.isValid ? appointmentDateTime.toISO() : \"\",\n        appointmentDateRaw: appointmentDateTime.isValid ? appointmentDateTime.toFormat(\"yyyy-MM-dd\") : \"\",\n        appointmentTimeRaw: appointmentDateTime.isValid ? appointmentDateTime.toFormat(\"HH:mm\") : \"\",\n        isValidDateTime: appointmentDateTime.isValid,\n        debugDate: dateText,\n        debugTime: timeText\n      }\n    };\n  });\n});\n"
      },
